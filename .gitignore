# Mutant cache. The engine writes .sabaku-cache.json in the working directory,
# or beside --output, so the pattern stays unanchored.
.sabaku-cache.json

# Gems built by `gem build`, which bin/check does.
*.gem

tmp/

# Bundler at the repo root. fixture/rails_app ships its own Gemfile.lock and
# .gitignore, so these stay anchored to the root.
/Gemfile.lock
/.bundle/
/vendor/bundle/

.DS_Store

# Generated by:
#   bin/formal   writes formal/out/, formal/lean/.lake/ and _apalache-out/
#   variants.sh  writes formal/quint/broken/ and formal/quint/broken-matrix/
formal/out/
formal/quint/broken/
formal/quint/broken-matrix/
formal/lean/.lake/
_apalache-out/
