#!/usr/bin/env bash
# The formal verification gate: Lean proofs, the Lean/Ruby replay, and the Quint models.
#
# The default run bounds both honest Quint models at six steps; the gate takes about twenty
# minutes on a laptop. `--deep` raises the runner bound to ten steps, a complete three-mutant
# campaign, and the matrix bound to eight steps, a complete two-mutant sweep pass.
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

deep=0
for arg in "$@"; do
  case "$arg" in
    --deep) deep=1 ;;
    *)
      echo "usage: bin/formal [--deep]" >&2
      exit 2
      ;;
  esac
done

invariants=(INV_one_result INV_done_has_result INV_uncovered_has_no_child INV_capacity
            INV_report_complete INV_report_has_every_result INV_score_bound
            INV_denominator_covers_timeouts INV_skip_from_boot_error
            INV_skip_without_child_after_survivor INV_rewrite_at_most_once
            INV_retry_measured_once INV_weak_has_no_child)

invariants_matrix=(INV_sweep_keeps_status INV_complete_row_is_truth INV_killed_row_has_first
                   INV_survivor_row_empty INV_row_only_for_scored INV_failed_sweep_incomplete
                   INV_unverified_incomplete INV_cache_hit_no_first_child
                   INV_row_from_cache_no_sweep INV_one_row_write INV_sweep_capacity
                   INV_report_after_sweeps)

echo "== lean: build and prove =="
(cd formal/lean && lake build)
if grep -rnE '\b(sorry|admit)\b' formal/lean/Sabaku >/dev/null; then
  echo "formal: an unfinished proof remains in formal/lean" >&2
  exit 1
fi

echo "== replay: the same splice and score from Lean and Ruby =="
mkdir -p formal/out
./bin/rt ruby formal/replay/emit.rb
(cd formal/lean && lake exe replay < ../out/replay.tsv)
./bin/rt ruby formal/replay/check.rb

echo "== quint: typecheck =="
for spec in formal/quint/*.qnt; do
  quint typecheck "$spec" >/dev/null
done

steps=6
steps_matrix=6
if [[ $deep -eq 1 ]]; then
  steps=10
  steps_matrix=8
fi

honest() {
  local model="$1" bound="$2" log="$3"
  shift 3
  echo "== quint: honest $model model at $bound steps =="
  if quint verify "formal/quint/$model.qnt" --max-steps="$bound" --invariants "$@" \
      > "formal/out/$log.log" 2>&1; then
    echo "  no violation at $bound steps"
  else
    echo "formal: the honest $model model violates an invariant" >&2
    tail -20 "formal/out/$log.log" >&2
    exit 1
  fi
}

broken() {
  local dir="$1" prefix="$2"
  shift 2
  for spec in "formal/quint/$dir"/*.qnt; do
    name=$(basename "$spec" .qnt)
    if quint verify "$spec" --max-steps=8 --invariants "$@" \
        > "formal/out/$prefix$name.log" 2>&1; then
      echo "formal: $dir/$name did not violate its invariant" >&2
      tail -20 "formal/out/$prefix$name.log" >&2
      exit 1
    fi
    echo "  $dir/$name: violation found"
  done
}

honest runner "$steps" quint-honest "${invariants[@]}"
honest matrix "$steps_matrix" quint-matrix-honest "${invariants_matrix[@]}"

echo "== quint: fault variants must violate =="
./formal/quint/variants.sh >/dev/null
broken broken quint- "${invariants[@]}"
broken broken-matrix quint-matrix- "${invariants_matrix[@]}"

echo "== findings stay fixed =="
./formal/regressions.sh

echo "formal: ok"
